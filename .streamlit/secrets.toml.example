# .streamlit/secrets.toml.example
# Copie este arquivo para .streamlit/secrets.toml e preencha com valores reais
# NUNCA commite o arquivo .streamlit/secrets.toml real (já está no .gitignore)

# ============================================================
# CHAVE MESTRA DE CRIPTOGRAFIA (OBRIGATÓRIA)
# ============================================================
# Gere com: openssl rand -base64 32
# DEVE SER IDÊNTICA no Apps Script (HMAC_KEY)
PS_FERNET_KEY = "<32-byte-urlsafe-base64>"

# ============================================================
# BACKEND APPS SCRIPT (OBRIGATÓRIO)
# ============================================================
# URL do Web App deployado (script.google.com → Implantar → Web App)
APPS_SCRIPT_URL = "https://script.google.com/macros/s/<DEPLOYMENT_ID>/exec"

# ============================================================
# LINKS KIWIFY (OBRIGATÓRIOS PARA PÁGINA DE LOGIN)
# ============================================================
LINK_KIWIFY_15_DIAS = "https://pay.kiwify.com.br/seu-link-15-dias"
LINK_KIWIFY_30_DIAS = "https://pay.kiwify.com.br/seu-link-30-dias"
LINK_KIWIFY_90_DIAS = "https://pay.kiwify.com.br/seu-link-90-dias"
LINK_KIWIFY_VITALICIO = "https://pay.kiwify.com.br/seu-link-vitalicio"