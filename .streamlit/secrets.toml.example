# .streamlit/secrets.toml — EXEMPLO PARA DESENVOLVIMENTO LOCAL
# COPIE PARA .streamlit/secrets.toml E PREENCHA COM SUAS CHAVES
# NUNCA COMITE O ARQUIVO REAL (protegido por .gitignore)

# Chave mestra Fernet (gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
PS_FERNET_KEY = "COLE_SUA_CHAVE_FERNET_AQUI_44_CHARS"

# URL do seu Apps Script (Deploy → Web App → URL)
APPS_SCRIPT_URL = "https://script.google.com/macros/s/SEU_SCRIPT_ID/exec"